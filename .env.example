# Copy to .env.local if you want to change a default. Nothing here is required.

# Port for npm start and npm run dev (binds 127.0.0.1).
PORT=4117

# Model for live claim checks: claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-5-5.
CHECK_MODEL=claude-opus-5-5

# 1 replays recorded live runs from fixtures/checks (no login, key or network).
DEMO_REPLAY=

# fake uses a scripted runner for tests and shows a Test mode badge.
CHECKER=

# Pause between replayed tool calls, in milliseconds.
REPLAY_DELAY_MS=280

# Folder for the SQLite file.
DATA_DIR=.data

# Optional: used instead of the local Claude Code login when set.
ANTHROPIC_API_KEY=
